# Salin file ini ke .env.local (untuk lokal) dan isi juga di Vercel > Project Settings > Environment Variables

# Login admin & kasir (wajib diganti sebelum dipakai sungguhan)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ganti-password-ini

# String acak bebas, dipakai untuk menandatangani sesi login. Ganti dengan teks acak panjang.
AUTH_SECRET=ganti-dengan-string-acak-yang-panjang-dan-rahasia

# Diisi OTOMATIS oleh Vercel saat kamu menambahkan integrasi database (Storage tab di dashboard Vercel:
# pilih "Upstash for Redis" / "KV"). Untuk pengembangan lokal, boleh dikosongkan — data akan disimpan
# sementara di file .data/db.json
KV_REST_API_URL=
KV_REST_API_TOKEN=
